# Copy to .env.local (local dev) and fill in values. Never commit .env files.
# Local: run `npm run db:start`, then copy API_URL / PUBLISHABLE_KEY / SECRET_KEY
#        from `npx supabase status`.
# Production: same variables in .env.prod (for *:prod scripts) and in Vercel,
#        from Supabase Dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: secret key (sb_secret_...) or legacy service_role key. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

DEFAULT_PASSWORD=123456
